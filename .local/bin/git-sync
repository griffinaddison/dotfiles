#!/bin/zsh
# git-sync <repo> — commit everything, pull --rebase, push. Idempotent.
#
# Replaces git-auto-sync (GitJournal) for the one thing we used it for: syncing
# a markdown repo on save. That tool also shells out to git, so nothing about
# git behavior changes; we just drop a per-machine brew/apt install.
#
# Not replaced: git-auto-sync's `daemon` mode (filesystem watching, 10-minute
# polling, sync on wake). Nothing here runs in the background. Sync happens when
# something calls this script.
#
# Called from nvim on BufWritePost/BufReadPre. Safe to run by hand.

set -u

REPO="${1:-}"
TRIES=3
STALE_LOCK_MIN=5
# Cap on any single network call. Must stay well under STALE_LOCK_MIN so a hung
# fetch can never outlive its own lock and let a second sync start alongside it.
NET_TIMEOUT=20

# Give git its own deadlines too, so it usually gives up before run_limited has
# to kill it. SSH won't sit in connect() forever; HTTPS won't sit on a stalled
# transfer forever.
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o ConnectTimeout=8 -o ServerAliveInterval=5 -o ServerAliveCountMax=2"
export GIT_HTTP_LOW_SPEED_LIMIT=1000
export GIT_HTTP_LOW_SPEED_TIME=15

if [[ -z "$REPO" ]]; then
  print -u2 "usage: git-sync <repo>"
  exit 2
fi

REPO="${REPO/#\~/$HOME}"

if [[ ! -d "$REPO" ]]; then
  print -u2 "git-sync: no such directory: $REPO"
  exit 2
fi

cd "$REPO" || exit 2

if ! GIT_DIR_PATH=$(git rev-parse --absolute-git-dir 2>/dev/null); then
  print -u2 "git-sync: not a git repo: $REPO"
  exit 2
fi

# Rebasing a detached HEAD onto an upstream that doesn't exist goes badly.
if ! BRANCH=$(git symbolic-ref --short -q HEAD); then
  print -u2 "git-sync: detached HEAD in $REPO, refusing to sync"
  exit 2
fi

LOCK="$GIT_DIR_PATH/git-sync.lock"

# A killed run leaves the lock behind. Anything older than STALE_LOCK_MIN is
# not a live sync.
if [[ -d "$LOCK" ]] && [[ -n "$(find "$LOCK" -maxdepth 0 -mmin +$STALE_LOCK_MIN 2>/dev/null)" ]]; then
  rmdir "$LOCK" 2>/dev/null
fi

# Don't stack overlapping runs. mkdir is atomic. Bail rather than queue: the
# next save syncs anyway.
if ! mkdir "$LOCK" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM

# Only pull/push when there's actually somewhere to pull from and push to. A
# local-only repo should still get its commits made.
has_upstream() {
  git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1
}

# macOS has no timeout(1). Run a command with a deadline and kill it if it
# overruns. Without this, one unreachable remote hangs the sync for as long as
# TCP takes to give up, all while holding the lock — so every later save
# silently does nothing.
run_limited() {
  local secs=$1; shift
  "$@" &
  local pid=$! waited=0
  while kill -0 $pid 2>/dev/null; do
    if (( waited >= secs * 10 )); then
      kill -9 $pid 2>/dev/null
      wait $pid 2>/dev/null
      return 124
    fi
    sleep 0.1
    (( waited++ ))
  done
  wait $pid
}

# Renaming Foo.md to foo.md on a case-insensitive filesystem leaves BOTH paths
# in the index. Git stats the old name, the new file answers, and the deletion
# is never noticed. On your Mac you see one file; the commit has two, and a
# teammate on Linux gets two. Drop index entries whose exact case isn't on disk.
prune_case_ghosts() {
  local ghosts
  ghosts=$(comm -23 \
    <(git ls-files | LC_ALL=C sort) \
    <(find . -type f -not -path './.git/*' | sed 's|^\./||' | LC_ALL=C sort))
  [[ -n "$ghosts" ]] && print -r -- "$ghosts" | tr '\n' '\0' | xargs -0 git rm --cached --quiet --
  return 0
}

# Returns 0 on success, 1 if worth retrying, 3 if a human has to look.
sync_once() {
  # Commit BEFORE touching the network. A dead remote should cost you the push,
  # not the commit. The old order fetched first, so an outage meant your work
  # was never recorded anywhere — and the script still reported success.
  prune_case_ghosts
  if [[ -n "$(git status --porcelain)" ]]; then
    git add -A || return 1
    git commit -q -m "$(hostname -s): $(date '+%Y-%m-%d %H:%M')" || return 1
  fi

  if has_upstream; then
    # Deliberately not `git pull --rebase`. Pull rebases onto whatever it finds
    # in FETCH_HEAD, and any other fetch running at the same time rewrites that
    # file — Obsidian's Git plugin fetches this same repo every 15s. When the
    # two overlap, pull sees more than one entry and dies with "Cannot rebase
    # onto multiple branches." Reproduced 40 times out of 40 by racing a fetch
    # against a pull.
    #
    # Fetching and then rebasing onto the tracking ref by name never reads
    # FETCH_HEAD, so a concurrent fetch can't confuse it.
    local upstream
    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}') || return 1
    run_limited $NET_TIMEOUT git fetch --quiet "$(git config --get branch.$BRANCH.remote)" || return 1

    if ! git rebase --autostash --quiet "$upstream"; then
      # Only a stopped rebase means a real conflict. Anything else that makes
      # rebase exit nonzero is worth retrying, and calling it a conflict sends
      # you looking for merge markers that aren't there.
      if [[ -d "$GIT_DIR_PATH/rebase-merge" || -d "$GIT_DIR_PATH/rebase-apply" ]]; then
        # Never leave the repo mid-rebase. The next run would fail on the wedged
        # state instead of on the real conflict, and it'd do it silently from a
        # nvim job callback. Aborting also restores the autostash by itself —
        # don't `stash pop` here or you may pop an unrelated entry.
        git rebase --abort 2>/dev/null
        return 3
      fi
      return 1
    fi
  fi

  # `rebase --autostash` exits 0 even when re-applying the autostash conflicts.
  # Without this check the next lines would `add -A` the conflict markers,
  # commit them, and push them. Measured, not theoretical.
  if [[ -n "$(git diff --name-only --diff-filter=U)" ]]; then
    return 3
  fi

  if has_upstream; then
    run_limited $NET_TIMEOUT git push --quiet || return 1
  fi

  return 0
}

err=""
for i in {1..$TRIES}; do
  err=$(sync_once 2>&1)
  rc=$?
  (( rc == 0 )) && exit 0
  if (( rc == 3 )); then
    print -u2 "git-sync: $REPO has conflicts that need resolving by hand"
    git -C "$REPO" diff --name-only --diff-filter=U 2>/dev/null | sed 's/^/  /' >&2
    [[ -n "$err" ]] && print -u2 "$err"
    exit 3
  fi
  # Another committer (Obsidian's Git plugin, another shell) may be holding
  # .git/index.lock. Give it a moment.
  (( i < TRIES )) && sleep 2
done

print -u2 "git-sync: $REPO failed after $TRIES tries (not a conflict)"
[[ -n "$err" ]] && print -u2 "$err"
exit 1
